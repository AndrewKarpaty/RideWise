# ---- LLM (routed through LiteLLM) ----
# Default model. Any LiteLLM-supported model string works.
RIDEWISE_LLM_MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=

# ---- Routing / geocoding: OpenRouteService (free key) ----
# Sign up: https://openrouteservice.org/dev/#/signup
RIDEWISE_ORS_API_KEY=

# ---- Observability: Langfuse (optional; tracing is skipped if unset) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Storage ----
# Defaults to sqlite:///<repo>/ridewise.db
# RIDEWISE_DATABASE_URL=
